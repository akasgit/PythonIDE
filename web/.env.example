# PythonIDE online. On shared hosting you normally do not need to edit this
# file: open https://your-site/install and fill in the form instead.
APP_NAME=PythonIDE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pythonide.aryalakash.com.np
APP_TIMEZONE=Asia/Kathmandu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

# MySQL database from cPanel > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Files, not the database, so the site works before the tables exist.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
